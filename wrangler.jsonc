{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static Vite build served as Workers static assets. The Worker script (worker/index.ts) runs only for /api/*
  // (run_worker_first): every other path is served straight from the assets, so the game itself costs no Worker CPU
  // and doesn't count against the free plan's daily request limit. /admin is admin.html via the default html_handling.
  // Station data and uploaded media live in the R2 bucket bound as MUSIC; media is public at MUSIC_BASE_URL.
  // Secrets (ADMIN_PASSWORD, SESSION_SECRET) are never in this file: see .dev.vars.example.
  "name": "aglow",
  "routes": [
    { "pattern": "aglow.lukeghanna.com", "custom_domain": true }
  ],
  "compatibility_date": "2026-10-01",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [{ "binding": "MUSIC", "bucket_name": "aglow-music" }],
  // Workers Logs: the router logs the route and error class of any unexpected failure (never messages or secrets).
  "observability": { "enabled": true },
  "vars": { "MUSIC_BASE_URL": "https://aglow-music.lukeghanna.com" },
  // Login attempts per IP, on top of the Worker's in-memory limiter.
  "ratelimits": [{ "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }]
}
